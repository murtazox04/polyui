{
  "id": "chart",
  "version": 1,
  "types": {
    "Chart": {
      "description": "A bar, line, area, pie or scatter chart drawn from rows of data.",
      "role": "figure",
      "children": false,
      "props": {
        "title": { "kind": "string", "max": 120, "required": true },
        "kind": { "kind": "enum", "values": ["bar", "line", "area", "pie", "scatter"], "required": true },
        "x_label": { "kind": "string", "max": 64, "description": "Name of the x axis, or of the slices in a pie." },
        "y_label": { "kind": "string", "max": 64, "description": "Name of the measured value." },
        "unit": { "kind": "string", "max": 16 },
        "rows": {
          "kind": "array",
          "max": 1000,
          "required": true,
          "of": {
            "kind": "object",
            "fields": {
              "x": { "kind": "scalar", "required": true, "description": "Category or x value." },
              "y": { "kind": "number", "required": true },
              "series": { "kind": "string", "max": 64, "description": "Splits rows into colored series." }
            }
          }
        },
        "on_select": { "kind": "action", "description": "Fires when the user taps a bar, point or slice. The selected row goes in the values." }
      },
      "alt": "{title}",
      "say": "{title}"
    },
    "Dashboard": {
      "description": "A grid of charts and stats.",
      "role": "group",
      "children": ["chart:Chart", "Stat", "Card", "Text"],
      "props": {
        "title": { "kind": "string", "max": 120 },
        "columns": { "kind": "int", "min": 1, "max": 4, "default": 2 }
      },
      "alt": "{title}. {children}",
      "say": "{title}. {children}"
    }
  }
}
