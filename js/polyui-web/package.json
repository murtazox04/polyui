{
  "name": "@polyui/web",
  "version": "0.1.4",
  "description": "Framework free web renderer for PolyUI surfaces",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Murtazo Xurramov",
  "homepage": "https://murtazox04.github.io/polyui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murtazox04/polyui.git",
    "directory": "js/polyui-web"
  },
  "bugs": "https://github.com/murtazox04/polyui/issues",
  "keywords": [
    "generative-ui",
    "llm",
    "agents",
    "mcp",
    "wasm"
  ],
  "sideEffects": false,
  "main": "./dist/polyui.js",
  "module": "./dist/polyui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/polyui.js"
    },
    "./polyui.css": "./dist/polyui.css",
    "./polyui_core_bg.wasm": "./dist/polyui_core_bg.wasm",
    "./embed-sandbox.html": "./embed-sandbox/index.html"
  },
  "files": [
    "dist/polyui.js",
    "dist/polyui.css",
    "dist/polyui_core_bg.wasm",
    "dist/*.d.ts",
    "embed-sandbox/index.html"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "wasm": "node ../../bindings/wasm/build.mjs",
    "test": "node scripts/build.mjs && vitest run",
    "size": "node scripts/size.mjs",
    "demo": "node scripts/build.mjs --serve"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
